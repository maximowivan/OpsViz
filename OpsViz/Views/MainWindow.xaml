<Window x:Class="OpsViz.Views.MainWindow"
        x:Name="RootWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:OpsViz.Controls"
        Title="Схема потоков операций" Height="900" Width="1600" WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="DivergedRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource BaseRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Diverged}" Value="True">
                    <Setter Property="Background" Value="#FDE6E6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Background="{StaticResource BBg}">
        <Border DockPanel.Dock="Top" Background="{StaticResource BPanel}" BorderBrush="{StaticResource BBorder}" BorderThickness="0,0,0,1" Padding="10,7">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding UpdateFromDbCommand}" Padding="12,5" Margin="0,0,6,0" ToolTip="Выгрузить операции из InduSoft I-OMS напрямую (тот же запрос, что кнопка «Операции» в Excel). Период — дата+время «с/по», по умолчанию текущие операционные сутки 12:00–12:00.">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Обновить из базы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Command="{Binding OpenFileCommand}" Padding="10,5" ToolTip="Открыть архивную Excel-выгрузку с листа «Операции» (для сверки с базой или без доступа к ней). Источник виден в статусбаре снизу.">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Открыть файл…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding PeriodText}" VerticalAlignment="Center" Foreground="{StaticResource BMuted}" FontSize="12" Margin="2,0,10,0"/>
                <Separator Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Продукт:" VerticalAlignment="Center" Foreground="{StaticResource BMuted}"/>
                    <ComboBox x:Name="ProductCombo" ItemsSource="{Binding Products}" Width="150" Margin="4,0,8,0" ToolTip="Показать только операции с этим продуктом (по источнику или приемнику)"/>
                    <TextBlock Text="Период с:" VerticalAlignment="Center" Foreground="{StaticResource BMuted}"/>
                    <DatePicker SelectedDate="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="4,0,4,0" ToolTip="Дата начала периода. Пусто — без ограничения."/>
                    <TextBox Text="{Binding TimeFromText, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,6,0" ToolTip="Время начала периода (ЧЧ:ММ). Операционные сутки начинаются в 12:00."/>
                    <TextBlock Text="по:" VerticalAlignment="Center" Foreground="{StaticResource BMuted}"/>
                    <DatePicker SelectedDate="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="4,0,4,0" ToolTip="Дата конца периода. Пусто — без ограничения."/>
                    <TextBox Text="{Binding TimeToText, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,0" ToolTip="Время конца периода (ЧЧ:ММ)."/>
                </StackPanel>
                <Separator Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <CheckBox Content="Массы на схеме" IsChecked="{Binding ShowLabels}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Показывать подписи масс и времени на линиях связей"/>
                    <CheckBox Content="Весь путь массы" IsChecked="{Binding ChainMode}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="При клике подсвечивать весь путь массы через цепочку объектов, а не только прямых соседей"/>
                    <CheckBox Content="Группировать операции" IsChecked="{Binding GroupPairs}" VerticalAlignment="Center" ToolTip="Склеить параллельные операции одной пары объектов в одну связь (масса ×N). Убирает макароны на узлах с десятками операций."/>
                </StackPanel>
                <Separator Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Foreground="{StaticResource BMuted}"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BMuted}" VerticalAlignment="Center" FontSize="12" Margin="4,0,4,0"/>
                    <TextBox x:Name="SearchBox" Width="130" Margin="0,0,6,0" ToolTip="Поиск объекта на схеме по имени. Enter — перейти к первому (схема центрируется), F3 — к следующему совпадению"/>
                    <TextBlock x:Name="SearchCount" VerticalAlignment="Center" Foreground="{StaticResource BAccent}" FontWeight="SemiBold" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button Content="Вписать в окно" Click="BtnFit_Click" Padding="10,5" ToolTip="Уместить всю схему в окно"/>
                    <Button Content="Сброс" Click="BtnReset_Click" Padding="10,5" Margin="6,0,0,0" ToolTip="Сбросить фильтры: продукт, период, поиск"/>
                    <Button Content="▤ Все операции" Click="BtnAllOps_Click" Padding="10,5" Margin="6,0,0,0" ToolTip="Открыть таблицу всех операций как в Excel: выбор нескольких строк, пометки цветом, переход к связи на схеме"/>
                    <Button x:Name="BtnShowHidden" Content="Показать скрытые" Click="BtnShowHidden_Click" Padding="10,5" Margin="6,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="BtnHideAll" Content="Скрыть всё" Click="BtnHideAll_Click" Padding="10,5" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Спрятать все объекты со схемы (вернуть — кнопкой «Показать скрытые», перейти к операции — через таблицу «Все операции»)"/>
                    <Button Content="Журнал" Click="BtnLog_Click" Padding="10,5" Margin="6,0,0,0" ToolTip="Открыть файл диагностики debug.log (что делала программа)"/>
                </StackPanel>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BPanel}" BorderBrush="{StaticResource BBorder}" BorderThickness="0,1,0,0" Padding="10,4" FontSize="11" Foreground="{StaticResource BMuted}">
            <TextBlock Text="{Binding StatusText}"/>
            <Separator/>
            <TextBlock Text="{Binding PeriodText}"/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="480" MinWidth="250" MaxWidth="1000"/>
            </Grid.ColumnDefinitions>
            <ctrl:FlowSchemaControl x:Name="Schema" Grid.Column="0"/>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BBorder}" ToolTip="Потяните, чтобы изменить ширину правой панели"/>
            <Border Grid.Column="2" Background="{StaticResource BBg}" BorderBrush="{StaticResource BBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <StackPanel Visibility="{Binding IsLegendVisible, Converter={StaticResource B2V}}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Продукты" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Legend}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Text}" FontSize="11.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Как пользоваться" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource BMuted}" TextWrapping="Wrap" Text=
"Kлик по объекту или линии — подсветка связанных операций. С опцией «Весь путь массы» подсвечивается весь путь: откуда пришла и куда идёт дальше. Узлы можно перетаскивать мышью, колесо — масштаб, фон — перемещение. Двойной клик по объекту — перейти к нему: объект со всеми связями и вписать в окно. Так ходят по цепочке от соседа к соседу — из тупика всегда есть куда раскрыться. Опция «Группировать операции» склеивает параллельные операции в одну связь — убирает макароны. Фильтры сверху: продукт и период. Кнопка «Все операции» — таблица всех операций как в Excel с пометками и переходом к связи. Кнопка «Обновить из базы» — выгрузка напрямую из InduSoft I-OMS без Excel (тот же запрос, что скрипт выгрузки; период из фильтров). Пунктиром внизу рисуются возвратные потоки. Входящие/исходящие операции видны сразу таблицей 1в1 как в Excel. Имена и теги выделяются мышью, любая ячейка — правой кнопкой «Копировать ячейку», Ctrl+C копирует строки."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsNodeDetails, Converter={StaticResource B2V}}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailsTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DetailsStats}" FontSize="11.5" Foreground="{StaticResource BMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Входящие операции:" Style="{StaticResource SectionTitle}" Margin="4,4,0,4"/>
                            <DataGrid x:Name="IncomingList" ItemsSource="{Binding IncomingRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="250" FontSize="11" HeadersVisibility="Column" CanUserSortColumns="True"
                                      ClipboardCopyMode="IncludeHeader" RowStyle="{StaticResource DivergedRowStyle}"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Single"
                                      MouseDoubleClick="GridRow_DoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Копировать ячейку" Click="CopyCell_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Название источника" Width="*" MinWidth="90" SortMemberPath="Counterpart">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Counterpart, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding Counterpart}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Название приемника" Binding="{Binding Op.ReceiverName}" Width="*" MinWidth="80" SortMemberPath="Op.ReceiverName"/>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding Op.Start, StringFormat={}{0:dd.MM HH:mm}}" Width="68" SortMemberPath="Op.Start"/>
                                    <DataGridTextColumn Header="Конец" Binding="{Binding Op.End, StringFormat={}{0:dd.MM HH:mm}}" Width="68" SortMemberPath="Op.End"/>
                                    <DataGridTextColumn Header="Прод.ист" Binding="{Binding Op.SourceProduct}" Width="68">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Op.SourceProduct}"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Прод.при" Binding="{Binding Op.ReceiverProduct}" Width="68">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Op.ReceiverProduct}"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ист." Binding="{Binding Op.SourceMass, StringFormat='{}{0:#,0.##}'}" Width="56"/>
                                    <DataGridTextColumn Header="При." Binding="{Binding Op.ReceiverMass, StringFormat='{}{0:#,0.##}'}" Width="56"/>
                                    <!-- Δ/Δ% скрыты: расхождение видно подсветкой строки -->
                                    <DataGridTemplateColumn Header="Тег ист." Width="90" SortMemberPath="Op.SourceTag">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Op.SourceTag, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding Op.SourceTag}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Тег при." Width="90" SortMemberPath="Op.ReceiverTag">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Op.ReceiverTag, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding Op.ReceiverTag}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="UID" Binding="{Binding Op.Uid}" Width="55"/>
                                    <DataGridTextColumn x:Name="ManSrcIn" Header="Руч.ист" Binding="{Binding Op.ManualSourceMass, StringFormat='{}{0:#,0.##}'}" Width="52" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ManDstIn" Header="Руч.при" Binding="{Binding Op.ManualReceiverMass, StringFormat='{}{0:#,0.##}'}" Width="52" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Исходящие операции:" Style="{StaticResource SectionTitle}" Margin="4,10,0,4"/>
                            <DataGrid x:Name="OutgoingList" ItemsSource="{Binding OutgoingRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="250" FontSize="11" HeadersVisibility="Column" CanUserSortColumns="True"
                                      ClipboardCopyMode="IncludeHeader" RowStyle="{StaticResource DivergedRowStyle}"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Single"
                                      MouseDoubleClick="GridRow_DoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Копировать ячейку" Click="CopyCell_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название источника" Binding="{Binding Op.SourceName}" Width="*" MinWidth="80" SortMemberPath="Op.SourceName"/>
                                    <DataGridTemplateColumn Header="Название приемника" Width="*" MinWidth="90" SortMemberPath="Counterpart">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Counterpart, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding Counterpart}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding Op.Start, StringFormat={}{0:dd.MM HH:mm}}" Width="68" SortMemberPath="Op.Start"/>
                                    <DataGridTextColumn Header="Конец" Binding="{Binding Op.End, StringFormat={}{0:dd.MM HH:mm}}" Width="68" SortMemberPath="Op.End"/>
                                    <DataGridTextColumn Header="Прод.ист" Binding="{Binding Op.SourceProduct}" Width="68">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Op.SourceProduct}"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Прод.при" Binding="{Binding Op.ReceiverProduct}" Width="68">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Op.ReceiverProduct}"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ист." Binding="{Binding Op.SourceMass, StringFormat='{}{0:#,0.##}'}" Width="56"/>
                                    <DataGridTextColumn Header="При." Binding="{Binding Op.ReceiverMass, StringFormat='{}{0:#,0.##}'}" Width="56"/>
                                    <!-- Δ/Δ% скрыты: расхождение видно подсветкой строки -->
                                    <DataGridTemplateColumn Header="Тег ист." Width="90" SortMemberPath="Op.SourceTag">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Op.SourceTag, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding Op.SourceTag}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Тег при." Width="90" SortMemberPath="Op.ReceiverTag">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Op.ReceiverTag, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding Op.ReceiverTag}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="UID" Binding="{Binding Op.Uid}" Width="55"/>
                                    <DataGridTextColumn x:Name="ManSrcOut" Header="Руч.ист" Binding="{Binding Op.ManualSourceMass, StringFormat='{}{0:#,0.##}'}" Width="52" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ManDstOut" Header="Руч.при" Binding="{Binding Op.ManualReceiverMass, StringFormat='{}{0:#,0.##}'}" Width="52" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsEdgeDetails, Converter={StaticResource B2V}}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailsTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DetailsStats}" FontSize="11.5" Foreground="{StaticResource BMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="EdgeOpsGrid" ItemsSource="{Binding EdgeOps}" AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="430" FontSize="11" HeadersVisibility="Column" CanUserSortColumns="True"
                                      ClipboardCopyMode="IncludeHeader" RowStyle="{StaticResource DivergedRowStyle}"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Single">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Копировать ячейку" Click="CopyCell_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding Start, StringFormat={}{0:dd.MM.yy HH:mm}}" Width="95"/>
                                    <DataGridTextColumn Header="Конец" Binding="{Binding End, StringFormat={}{0:dd.MM.yy HH:mm}}" Width="95"/>
                                    <DataGridTextColumn Header="Продукт ист." Binding="{Binding SourceProduct}" Width="110"/>
                                    <DataGridTextColumn Header="Продукт при." Binding="{Binding ReceiverProduct}" Width="110"/>
                                    <DataGridTextColumn Header="Масса ист." Binding="{Binding SourceMass, StringFormat='{}{0:#,0.##}'}" Width="75"/>
                                    <DataGridTextColumn Header="Масса при." Binding="{Binding ReceiverMass, StringFormat='{}{0:#,0.##}'}" Width="75"/>
                                    <!-- Δ/Δ% скрыты: расхождение видно подсветкой строки -->
                                    <DataGridTemplateColumn Header="Тег ист." Width="130" SortMemberPath="SourceTag">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding SourceTag, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding SourceTag}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Тег при." Width="130" SortMemberPath="ReceiverTag">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ReceiverTag, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" ToolTip="{Binding ReceiverTag}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="80"/>
                                    <DataGridTextColumn x:Name="ManSrcEdge" Header="Руч.ист" Binding="{Binding ManualSourceMass, StringFormat='{}{0:#,0.##}'}" Width="65" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ManDstEdge" Header="Руч.при" Binding="{Binding ManualReceiverMass, StringFormat='{}{0:#,0.##}'}" Width="65" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>