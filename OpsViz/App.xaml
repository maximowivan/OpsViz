<Application x:Class="OpsViz.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- ============ Палитра OpsViz 2026 (светлая, акцент оранжевый) ============ -->
        <Color x:Key="CAccent">#EA580C</Color>
        <Color x:Key="CAccentDark">#C2410C</Color>
        <Color x:Key="CAccentSoft">#FFF1E6</Color>
        <Color x:Key="CBg">#F7F8FA</Color>
        <Color x:Key="CPanel">#FFFFFF</Color>
        <Color x:Key="CBorder">#E2E8F0</Color>
        <Color x:Key="CBorderDark">#CBD5E1</Color>
        <Color x:Key="CText">#1E293B</Color>
        <Color x:Key="CMuted">#64748B</Color>
        <Color x:Key="CGood">#16A34A</Color>
        <Color x:Key="CBad">#DC2626</Color>
        <Color x:Key="CMark">#FFF3B0</Color>
        <Color x:Key="CDiverged">#FDE6E6</Color>
        <SolidColorBrush x:Key="BAccent" Color="{StaticResource CAccent}"/>
        <SolidColorBrush x:Key="BAccentDark" Color="{StaticResource CAccentDark}"/>
        <SolidColorBrush x:Key="BAccentSoft" Color="{StaticResource CAccentSoft}"/>
        <SolidColorBrush x:Key="BBg" Color="{StaticResource CBg}"/>
        <SolidColorBrush x:Key="BPanel" Color="{StaticResource CPanel}"/>
        <SolidColorBrush x:Key="BBorder" Color="{StaticResource CBorder}"/>
        <SolidColorBrush x:Key="BBorderDark" Color="{StaticResource CBorderDark}"/>
        <SolidColorBrush x:Key="BText" Color="{StaticResource CText}"/>
        <SolidColorBrush x:Key="BMuted" Color="{StaticResource CMuted}"/>
        <SolidColorBrush x:Key="BGood" Color="{StaticResource CGood}"/>
        <SolidColorBrush x:Key="BBad" Color="{StaticResource CBad}"/>

        <!-- ============ Кнопки ============ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorderDark}"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BAccentDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BAccentDark}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BAccentDark}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#9A3412"/>
                    <Setter Property="BorderBrush" Value="#9A3412"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Текстовые поля ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorderDark}"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Чекбоксы ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="{StaticResource BPanel}" BorderBrush="{StaticResource BBorderDark}" BorderThickness="1.5">
                                <Path x:Name="Mark" Data="M 3.5,8.5 L 7,12 L 12.5,4" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource BAccent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BAccentDark}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Комбобоксы ============ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorderDark}"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾" Foreground="{StaticResource BMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="Tgl" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                <Border Background="{StaticResource BPanel}" BorderBrush="{StaticResource BBorderDark}"
                                        BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource BAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource BAccentSoft}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Датапикеры (рамка в тему, календарь системный) ============ -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorderDark}"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ============ Тумблер-кнопка (Только помеченные) ============ -->
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorderDark}"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BAccentSoft}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Таблицы ============ -->
        <Style x:Key="BaseColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="BaseRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BAccentSoft}"/>
                    <Setter Property="Foreground" Value="{StaticResource BText}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource BPanel}"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EDF2F7"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource BaseColumnHeader}"/>
            <Setter Property="RowStyle" Value="{StaticResource BaseRowStyle}"/>
        </Style>

        <!-- ============ Карточки и заголовки панелей ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Application.Resources>
</Application>
